# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Postgres + Auth + RLS) ───────────────────────────────────────
# Project URL and the publishable/anon key are SAFE in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely — the application must re-derive the
# actor and re-check permissions itself on every path that uses this.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations and CI.
SUPABASE_DB_URL=

# ─── Paystack ───────────────────────────────────────────────────────────────
# Use TEST keys until launch. pk_test_ / sk_test_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# HMAC-SHA512 signature secret from the Paystack dashboard. Without it
# /api/webhooks/paystack is an UNAUTHENTICATED endpoint: anyone can POST a
# fake "charge.success" and mark a customer's order paid.
PAYSTACK_WEBHOOK_SECRET=

# Paystack rejects charges below this. Enforced server-side too.
PAYSTACK_MIN_KOBO=5000

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# Two buckets, on purpose: a public catalogue image must never be reachable
# through the same policy as a proof-of-delivery photo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_PUBLIC_MEDIA=veecart-public-media
R2_BUCKET_PRIVATE_FILES=veecart-private-files
R2_PUBLIC_MEDIA_BASE_URL=

# ─── Email ──────────────────────────────────────────────────────────────────
# Transactional email only. SMS/WhatsApp are deliberately absent from this
# file: adding them changes the operating cost model and needs a new decision.
RESEND_API_KEY=
EMAIL_FROM="Veecart Logistics <no-reply@example.com>"

# ─── Rate limiting / monitoring ─────────────────────────────────────────────
# Upstash Redis for public endpoints (tracking lookup, booking).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry / error monitoring. Optional in development, required before launch.
SENTRY_DSN=

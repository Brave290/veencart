# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Postgres + Auth + RLS) ───────────────────────────────────────
# Project URL and the publishable/anon key are SAFE in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely — the application must re-derive the
# actor and re-check permissions itself on every path that uses this.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations and CI.
SUPABASE_DB_URL=

# ─── Paystack ───────────────────────────────────────────────────────────────
# Use TEST keys until launch. pk_test_ / sk_test_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ─── Paystack webhook verification ───────────────────────────────────────────
# THERE IS NO SEPARATE PAYSTACK WEBHOOK SECRET.
#
# This is not Stripe, and there is no `whsec_...` value in the Paystack
# dashboard. Earlier revisions of this file and of docs/DEPLOYMENT.md invented
# `PAYSTACK_WEBHOOK_SECRET` and told you to "copy the Webhook Secret from the
# Paystack dashboard". That field does not exist, and following the instruction
# wastes an afternoon.
#
# How it actually works, per Paystack's live docs (28 Sep 2026):
#   header : `x-paystack-signature`
#   digest : HMAC-SHA512, lowercase hex, 128 characters
#   KEY    : your API SECRET KEY (PAYSTACK_SECRET_KEY above) — that is the key
#   input : the RAW REQUEST BODY BYTES
#
# The raw-body requirement is the single most common cause of "my Paystack
# webhook never verifies": hashing a re-serialised JSON object produces a
# different digest even when the data is identical. Capture the bytes before any
# body parser touches the stream.
#
# Consequences that shape the design:
#   * An sk_test_ key will NOT verify a live-mode event, and vice versa.
#   * The signature covers the body ONLY — no timestamp, nonce or version field,
#     so there is NO replay protection. A captured (body, signature) pair stays
#     valid indefinitely.
#   * Paystack states resending is NOT idempotent: the same event id delivered
#     twice really does arrive twice.
#   * Therefore the database dedupe on the event id is the ONLY replay defence.
#     It is a security control, not housekeeping.
#
# Nothing extra belongs in .env — verification uses PAYSTACK_SECRET_KEY.
# If this file ever grows a PAYSTACK_WEBHOOK_SECRET again, assume it is wrong.

# Paystack rejects charges below this. Enforced server-side too.
PAYSTACK_MIN_KOBO=5000

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# Two buckets, on purpose: a public catalogue image must never be reachable
# through the same policy as a proof-of-delivery photo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_PUBLIC_MEDIA=veencart-public-media
R2_BUCKET_PRIVATE_FILES=veencart-private-files
R2_PUBLIC_MEDIA_BASE_URL=

# ─── Email ──────────────────────────────────────────────────────────────────
# Transactional email only. SMS/WhatsApp are deliberately absent from this
# file: adding them changes the operating cost model and needs a new decision.
RESEND_API_KEY=
EMAIL_FROM="Veencart Logistics <no-reply@example.com>"

# ─── Rate limiting / monitoring ─────────────────────────────────────────────
# Upstash Redis for public endpoints (tracking lookup, booking).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry / error monitoring. Optional in development, required before launch.
SENTRY_DSN=

# ─── Local development database (PGlite) ─────────────────────────────────────
# OPTIONAL. All three default to the safe behaviour, and all three are refused
# on a real deployment. See docs/ENVIRONMENT.md for the full reasoning.
#
# SEED_DEMO_DATA loads backend/supabase/seed.sql into the local database. Demo
# data ONLY. Leave unset anywhere real: the seed publishes fabricated shipments
# to the public /track page.
SEED_DEMO_DATA=1

# Where the local PGlite database lives. Defaults to backend/.pglite.
PGLITE_DATA_DIR=

# ALLOW_DEV_DB_IN_PRODUCTION lets the file-backed development adapter run under
# NODE_ENV=production, for PREVIEW deploys where demo data is the point.
# Defaults to off, so forgetting it fails closed rather than silently serving
# ephemeral data. Do not set this on the production domain.
ALLOW_DEV_DB_IN_PRODUCTION=

# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
**/.next/
out/
next-env.d.ts
**/next-env.d.ts
*.tsbuildinfo

# Environment — NEVER commit real secrets.
# `.env*` is ignored wholesale and `.env.example` is re-included below, so
# adding a variable to the example file can never be blocked by this rule.
.env
.env.*
!.env.example

# Vercel CLI writes env.local, and it does NOT match the .env* pattern above.
# Without this, a single `git add .` publishes real secrets. Found by the
# devops audit — a gap, not a stylistic preference.
env.local

# Test + tooling artefacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local database snapshots from PGlite runs
*.pgdata/
.pglite/
# Broken git metadata from before the directory move — not part of the project.
.git.unreadable-*
